          <td>${s.seq}</td>
          <td><b>${s.name}</b><br><span style="color:#64748b; font-size:10px;">${s.address}</span></td>
          <td>${s.status === 'completed' ? '✅' : s.status === 'failed' ? '❌' : '⏳'}</td>
          <td>${a.facings || '-'}</td>
          <td>${a.oos ? '<span style="color:#ef4444; font-weight:800;">DA</span>' : 'Nu'}</td>
          <td>📷 ${pCnt}</td>
        `;
        tbody.appendChild(tr);
      });

      document.getElementById("reportsModal").classList.add("active");
    }

    function copyWhatsAppReport() {
      const dayStores = storesData.filter(s => s.day === currentDay);
      const comp = dayStores.filter(s => s.status === 'completed').length;
      const fail = dayStores.filter(s => s.status === 'failed').length;
      const total = dayStores.length;
      const pct = total ? Math.round((comp / total) * 100) : 0;

      let msg = `📊 *RAPORT AUDIT TEREN*\n`;
      msg += `📍 *${DAY_DESCRIPTIONS[currentDay] || 'Ziua ' + currentDay}*\n`;
      msg += `🏠 *Pornire & Sosire:* Comuna Brănești, Ilfov\n`;
      msg += `------------------------------------\n`;
      msg += `📈 Progres: ${comp}/${total} (${pct}%)\n`;
      msg += `✅ Rezolvate: ${comp} | ❌ Nerezolvate: ${fail} | ⏳ Rămase: ${total - comp - fail}\n\n`;
      msg += `📋 *MAGAZINE VIZITATE:*\n`;

      dayStores.forEach(s => {
        const icon = s.status === 'completed' ? '✅' : s.status === 'failed' ? '❌' : '⏳';
        msg += `${s.seq}. ${icon} *${s.name}*`;
        if (s.status === 'completed') {
          msg += ` (${s.timestamp || 'OK'})`;
          if (s.audit.facings) msg += ` | Fețe: ${s.audit.facings}`;
          if (s.audit.price) msg += ` | Preț: ${s.audit.price} lei`;
          if (s.audit.oos) msg += ` | ⚠️ *LIPSĂ STOC*`;
        } else if (s.status === 'failed') {
          msg += ` | Motiv: ${s.reason || 'Nerezolvat'}`;
        }
        msg += `\n`;
      });

      navigator.clipboard.writeText(msg).then(() => {
        alert("✅ Raportul a fost copiat în Clipboard!");
      }).catch(() => {
        prompt("Copiază textul pentru WhatsApp:", msg);
      });
    }

    function exportCSV() {
      const headers = ["ID", "Ziua", "Numar_Ordine", "Brand", "Nume Magazin", "Judet", "Oras", "Adresa", "Lat", "Lng", "Status", "Ora", "Motiv", "Categorie", "Pret_Raft", "Pret_Promo", "Fete", "OOS", "Observatii"];
      const rows = storesData.map(s => [
        `"${s.id}"`, `"Ziua ${s.day}"`, s.seq, `"${s.brand}"`, `"${s.name.replace(/"/g, '""')}"`,
        `"${s.judet}"`, `"${s.oras}"`, `"${s.address.replace(/"/g, '""')}"`,
        s.lat, s.lng, `"${s.status}"`, `"${s.timestamp || ''}"`,
        `"${(s.reason || '').replace(/"/g, '""')}"`, `"${(s.audit?.category || '').replace(/"/g, '""')}"`,
        `"${s.audit?.price || ''}"`, `"${s.audit?.promo || ''}"`, `"${s.audit?.facings || ''}"`,
        s.audit?.oos ? "DA" : "NU", `"${(s.audit?.notes || '').replace(/"/g, '""')}"`
      ]);

      const csvContent = "\uFEFF" + [headers.join(";"), ...rows.map(r => r.join(";"))].join("\r\n");
      const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = `Raport_Teren_124_Magazine_Ziua_${currentDay}.csv`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function openBackupModal() { document.getElementById("backupModal").classList.add("active"); }

    function exportFullBackup() {
      const blob = new Blob([JSON.stringify(storesData, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = `Backup_RutaTeren_124_${new Date().toISOString().slice(0,10)}.json`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function importFullBackup(e) {
      const file = e.target.files[0];
      if (!file) return;
      const r = new FileReader();
      r.onload = function(evt) {
        try {
          const d = JSON.parse(evt.target.result);
          if (Array.isArray(d)) {
            storesData = d;
            saveToStorage();
            renderDayChips();
            renderCurrentDay();
            closeModal('backupModal');
            alert("✅ Datele au fost restaurate cu succes!");
          }
        } catch(err) { alert("❌ Fișier invalid!"); }
      };
      r.readAsText(file);
    }

    function resetCurrentDayData() {
      if (!confirm(`Sigur vrei să resetezi datele pentru Ziua ${currentDay}?`)) return;
      storesData.forEach(s => {
        if (s.day === currentDay) {
          s.status = 'pending';
          s.timestamp = null;
          s.reason = '';
          s.audit = { category: '', facings: '', price: '', promo: '', oos: false, notes: '', photoBefore: null, photoAfter: null };
        }
      });
      saveToStorage();
      renderDayChips();
      renderCurrentDay();
      closeModal('backupModal');
    }

    function closeModal(id) { document.getElementById(id).classList.remove("active"); }

    function toggleDrawer() {
      const d = document.getElementById("storeDrawer");
      d.style.maxHeight = (d.style.maxHeight === "15%") ? "48%" : "15%";
    }

    window.addEventListener("DOMContentLoaded", () => {
      initData();
      initMap();
    });
  </script>
</body>
</html>
