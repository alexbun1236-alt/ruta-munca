    function confirmUnresolved() {
      const storeId = document.getElementById("unresolvedStoreId").value;
      const select = document.getElementById("unresolvedReasonSelect");
      const details = document.getElementById("unresolvedDetails").value.trim();
      let r = select.value;
      if (details) r += ` - ${details}`;
