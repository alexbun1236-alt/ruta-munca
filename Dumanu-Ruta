    };

    /* ==========================================================================
       APP STATE & LOCAL STORAGE
       ========================================================================== */
    let currentDay = 1;
    let storesData = [];
    let selectedStoreId = null;
    let currentFilter = 'all'; // 'all' | 'pending' | 'completed'
    let searchQuery = '';

    // GPS Live Tracking Variables
    let isTrackingGPS = false;
    let gpsWatchId = null;
    let userLocation = null;
    let userMarker = null;
    let userAccuracyCircle = null;

    let map = null;
    let markersLayer = null;
    let routeLayer = null;

    function initData() {
      const saved = localStorage.getItem("rutateren_124_v4_gmaps");
      if (saved) {
        try {
          storesData = JSON.parse(saved);
        } catch(e) {
          storesData = createFreshStoresData();
        }
      } else {
        storesData = createFreshStoresData();
      }
      saveToStorage();
    }

    function createFreshStoresData() {
      return STORES_MASTER.map(s => ({
        ...s,
        status: "pending",
        timestamp: null,
        reason: "",
        audit: {
          category: "",
          facings: "",
          price: "",
          promo: "",
          oos: false,
