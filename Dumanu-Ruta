<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Rută Audit 124 Magazine - Google Maps & Baza Brănești</title>
  
  <!-- iOS PWA Meta Tags -->
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="RutaTeren124" />
  <meta name="theme-color" content="#0f172a" />

  <!-- Leaflet CDN -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <style>
    :root {
      --bg-dark: #0f172a;
      --bg-card: #1e293b;
      --bg-card-alt: #334155;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #3b82f6;
      --primary-glow: rgba(59, 130, 246, 0.4);
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
      --pending: #64748b;
      --border: rgba(255, 255, 255, 0.08);
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* Header */
    header {
      background: rgba(15, 23, 42, 0.96);
      backdrop-filter: blur(12px);
      padding: calc(var(--safe-top) + 6px) 12px 6px 12px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      border-bottom: 1px solid var(--border);
      z-index: 1000;
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand-title {
      font-size: 13.5px;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 6px;
      color: #fff;
    }

    .brand-badge {
      background: #0284c7;
      color: #fff;
      font-size: 9.5px;
      padding: 2px 6px;
      border-radius: 6px;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .header-actions {
      display: flex;
      gap: 6px;
    }

    .btn-header {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-main);
      padding: 6px 9px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      min-height: 34px;
      transition: all 0.2s;
    }
    .btn-header:active { transform: scale(0.96); background: var(--bg-card-alt); }

    .btn-gps-toggle {
      background: #1e293b;
      border-color: #475569;
      color: #94a3b8;
    }
    .btn-gps-toggle.active {
      background: rgba(16, 185, 129, 0.2);
      border-color: var(--success);
      color: #34d399;
      box-shadow: 0 0 10px rgba(16, 185, 129, 0.3);
    }

    /* Day Chips Bar */
    .day-chips-bar {
      display: flex;
      gap: 5px;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }
    .day-chips-bar::-webkit-scrollbar { display: none; }

    .day-chip {
      flex: 0 0 auto;
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 4px 9px;
      border-radius: 16px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      min-height: 30px;
      transition: all 0.2s;
    }
    .day-chip.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
      box-shadow: 0 0 8px var(--primary-glow);
    }
    .day-chip .chip-count {
      font-size: 9px;
      background: rgba(0, 0, 0, 0.35);
      padding: 1px 5px;
      border-radius: 8px;
    }

    /* Main Content */
    .app-main {
      flex: 1;
      position: relative;
      display: flex;
      overflow: hidden;
    }

    .map-container {
      flex: 1;
      height: 100%;
      position: relative;
      background: #0b1120;
    }

    #map { width: 100%; height: 100%; }

    /* Custom Leaflet Layer Control Dark Theme */
    .leaflet-control-layers {
      background: rgba(15, 23, 42, 0.92) !important;
      border: 1px solid var(--border) !important;
      border-radius: 10px !important;
      color: #f8fafc !important;
      box-shadow: 0 4px 14px rgba(0,0,0,0.5) !important;
      font-size: 11px !important;
      font-weight: 600 !important;
      padding: 6px 10px !important;
    }
    .leaflet-control-layers-toggle {
      filter: invert(1);
    }

    /* Map Floating Controls */
    .map-floating-panel {
      position: absolute;
      top: 10px;
      left: 10px;
      right: 10px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 800;
      pointer-events: none;
    }
    .map-floating-panel > * { pointer-events: auto; }

    .nearest-banner {
      background: rgba(15, 23, 42, 0.94);
      backdrop-filter: blur(8px);
      border: 1px solid #38bdf8;
      border-radius: 12px;
      padding: 8px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 16px rgba(0,0,0,0.4);
    }
    .nearest-text { font-size: 12px; color: #e2e8f0; line-height: 1.3; }
    .nearest-text strong { color: #38bdf8; }

    /* Store Drawer / List */
    .store-drawer {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      background: rgba(15, 23, 42, 0.97);
      backdrop-filter: blur(14px);
      border-top: 1px solid var(--border);
      border-radius: 18px 18px 0 0;
      max-height: 48%;
      display: flex;
      flex-direction: column;
      transition: max-height 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1000;
      padding-bottom: var(--safe-bottom);
      box-shadow: 0 -8px 24px rgba(0,0,0,0.5);
    }

    .drawer-handle-bar {
      width: 44px;
      height: 4px;
      background: #64748b;
      border-radius: 2px;
      margin: 8px auto 4px auto;
      cursor: pointer;
    }

    .drawer-header {
      padding: 4px 14px 6px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .drawer-title { font-size: 13px; font-weight: 700; color: #cbd5e1; }
    .progress-pill {
      font-size: 11px;
      padding: 2px 8px;
      background: #1e293b;
      border-radius: 10px;
      font-weight: 700;
      border: 1px solid var(--border);
      color: #38bdf8;
    }

    /* Quick Search & Filter */
    .drawer-search-row {
      padding: 6px 12px;
      display: flex;
      gap: 6px;
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .search-input {
      flex: 1;
      background: #0f172a;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 6px 10px;
      font-size: 12px;
      color: #fff;
      outline: none;
    }
    .search-input:focus { border-color: var(--primary); }

    .filter-btn-group { display: flex; gap: 4px; }
    .btn-filter {
      background: #1e293b;
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 10.5px;
      font-weight: 700;
      cursor: pointer;
    }
    .btn-filter.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
    }

    .store-list {
      flex: 1;
      overflow-y: auto;
      padding: 8px 10px 24px 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    /* Store Cards */
    .store-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: all 0.15s ease-out;
    }
    .store-card.active {
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }
    .store-card.completed { border-left: 4px solid var(--success); }
    .store-card.failed { border-left: 4px solid var(--danger); }
    .store-card.pending { border-left: 4px solid var(--pending); }

    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
      cursor: pointer;
    }

    .card-info { flex: 1; }

    .store-brand-tag {
      font-size: 9.5px;
      font-weight: 800;
      padding: 2px 5px;
      border-radius: 4px;
      text-transform: uppercase;
      margin-right: 4px;
    }
    .tag-mega { background: #dc2626; color: #fff; }
    .tag-penny { background: #b91c1c; color: #fef08a; border: 1px solid #fef08a; }
    .tag-profi { background: #eab308; color: #000; }

    .store-name {
      font-size: 13.5px;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 4px;
      margin-bottom: 2px;
    }

    .store-seq {
      background: #334155;
      color: #38bdf8;
      font-size: 10px;
      padding: 1px 5px;
      border-radius: 4px;
      font-weight: 800;
    }

    .store-address {
      font-size: 11.5px;
      color: var(--text-muted);
      line-height: 1.35;
    }

    .store-live-dist {
      display: inline-block;
      font-size: 10.5px;
      font-weight: 700;
      color: #38bdf8;
      margin-top: 3px;
    }

    .status-badge {
      font-size: 9.5px;
      font-weight: 700;
      padding: 3px 6px;
      border-radius: 6px;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .status-badge.completed { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid #10b981; }
    .status-badge.failed { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid #ef4444; }
    .status-badge.pending { background: rgba(100, 116, 139, 0.2); color: #cbd5e1; border: 1px solid #64748b; }

    .card-actions {
      display: flex;
      gap: 5px;
      flex-wrap: wrap;
    }

    .btn-action {
      flex: 1;
      min-width: 62px;
      min-height: 36px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 3px;
      text-decoration: none;
      color: #fff;
      background: #1e293b;
      padding: 0 6px;
    }
    .btn-action:active { transform: scale(0.96); }

    .btn-waze { background: #00b4d8; border-color: #0096c7; color: #000; font-weight: 800; }
    .btn-gmaps { background: #ea4335; border-color: #c5221f; }
    .btn-resolve { background: var(--success); border-color: #059669; }
    .btn-unresolve { background: var(--danger); border-color: #dc2626; }
    .btn-audit { background: #6366f1; border-color: #4f46e5; }

    /* Draggable Floating FAB (Messenger Style) */
    .draggable-fab {
      position: fixed;
      width: 56px;
      height: 56px;
      border-radius: 28px;
      background: linear-gradient(135deg, #6366f1, #3b82f6);
      box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5), 0 0 0 2px rgba(255, 255, 255, 0.3);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: grab;
      z-index: 2000;
      touch-action: none;
      color: #fff;
      font-size: 9px;
      font-weight: 800;
      user-select: none;
    }
    .draggable-fab:active { cursor: grabbing; transform: scale(0.95); }
    .fab-icon { font-size: 18px; line-height: 1; }

    /* Custom Leaflet Map Markers */
    .custom-pin {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      color: white;
      font-weight: 800;
      font-size: 11px;
      box-shadow: 0 3px 8px rgba(0,0,0,0.5);
      border: 2px solid white;
      transition: all 0.2s;
    }
    .custom-pin.pending { background-color: var(--pending); }
    .custom-pin.completed { background-color: var(--success); }
    .custom-pin.failed { background-color: var(--danger); }
    .custom-pin.home { background-color: #f59e0b; font-size: 15px; border-color: #fef08a; }
    .custom-pin.active {
      transform: scale(1.3);
      border-color: #38bdf8;
      box-shadow: 0 0 14px #38bdf8;
    }

    /* Live GPS User Marker (Pulse + Radar) */
    .live-gps-marker {
      width: 20px;
      height: 20px;
      background: #0284c7;
      border-radius: 50%;
      border: 3px solid #ffffff;
      box-shadow: 0 0 10px rgba(2, 132, 199, 0.8);
      position: relative;
    }
    .live-gps-marker::after {
      content: "";
      position: absolute;
      top: -8px; left: -8px; right: -8px; bottom: -8px;
      border-radius: 50%;
      background: rgba(2, 132, 199, 0.35);
      animation: pulse-ring 1.8s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.6); opacity: 1; }
      100% { transform: scale(2.4); opacity: 0; }
    }

    /* Modals */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(6px);
      z-index: 3000;
      display: none;
      align-items: flex-end;
      justify-content: center;
      padding-top: var(--safe-top);
    }
    .modal-overlay.active { display: flex; }

    .modal-content {
      background: var(--bg-card);
      border-top: 1px solid var(--border);
      border-radius: 20px 20px 0 0;
      width: 100%;
      max-width: 650px;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding-bottom: calc(var(--safe-bottom) + 12px);
      animation: slide-up 0.25s ease-out;
    }
    @keyframes slide-up {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }

    .modal-header {
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
    }
    .modal-title { font-size: 15px; font-weight: 700; color: #fff; }
    .btn-close {
      background: #334155;
      border: none;
      color: #fff;
      font-size: 16px;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      cursor: pointer;
    }

    .modal-body {
      padding: 14px 16px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .form-group { display: flex; flex-direction: column; gap: 4px; }
    .form-label { font-size: 11.5px; font-weight: 600; color: var(--text-muted); }
    .form-input, .form-select, .form-textarea {
      background: #0f172a;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: #fff;
      padding: 9px 11px;
      font-size: 13.5px;
      outline: none;
    }
    .form-input:focus, .form-select:focus, .form-textarea:focus { border-color: var(--primary); }
    .form-row { display: flex; gap: 8px; }
    .form-row > * { flex: 1; }

    .toggle-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #0f172a;
      padding: 9px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
    }
    .toggle-switch { position: relative; display: inline-block; width: 46px; height: 24px; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .toggle-slider {
      position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
      background-color: #475569;
      border-radius: 24px;
      transition: .25s;
    }
    .toggle-slider:before {
      position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px;
      background-color: white;
      border-radius: 50%;
      transition: .25s;
    }
    input:checked + .toggle-slider { background-color: var(--danger); }
    input:checked + .toggle-slider:before { transform: translateX(22px); }

    .photo-grid { display: flex; gap: 8px; }
    .photo-box {
      flex: 1;
      border: 2px dashed #475569;
      border-radius: 10px;
      padding: 6px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 105px;
      background: #0f172a;
      position: relative;
      overflow: hidden;
      cursor: pointer;
    }
    .photo-box img { width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; }
    .photo-box-title { font-size: 11px; font-weight: 700; color: #94a3b8; }
    .photo-box-sub { font-size: 10px; color: #64748b; margin-top: 2px; }

    .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 10px; }
    .kpi-card { background: #0f172a; border: 1px solid var(--border); border-radius: 8px; padding: 8px; text-align: center; }
    .kpi-num { font-size: 17px; font-weight: 800; color: #fff; }
    .kpi-label { font-size: 10px; color: var(--text-muted); }

    .report-table-container { overflow-x: auto; border: 1px solid var(--border); border-radius: 8px; }
    .report-table { width: 100%; border-collapse: collapse; font-size: 11px; text-align: left; }
    .report-table th, .report-table td { padding: 7px; border-bottom: 1px solid var(--border); }
    .report-table th { background: #0f172a; color: #94a3b8; font-weight: 700; }

    @media (min-width: 769px) {
      .app-main { flex-direction: row; }
      .store-drawer {
        position: relative;
        width: 400px;
        max-height: 100%;
        border-radius: 0;
        border-top: none;
        border-left: 1px solid var(--border);
        box-shadow: none;
      }
      .drawer-handle-bar { display: none; }
      .modal-content { border-radius: 16px; margin: auto; max-height: 85vh; }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="header-top">
      <div class="brand-title">
        <span>📍 Rută 124 Magazine</span>
        <span class="brand-badge">🏠 Baza: Brănești</span>
      </div>
      <div class="header-actions">
        <!-- Live GPS Tracking Button -->
        <button class="btn-header btn-gps-toggle" id="btnGpsToggle" onclick="toggleGpsTracking()">🛰️ Pornire GPS</button>
        <button class="btn-header" onclick="recenterHome()">🏠 Acasă</button>
        <button class="btn-header" onclick="openReportsModal()">📊 Raport</button>
        <button class="btn-header" onclick="openBackupModal()">⚙️ Date</button>
      </div>
    </div>

    <!-- 10 Day Tabs -->
    <div class="day-chips-bar" id="dayChipsBar"></div>
  </header>

  <!-- Main View -->
  <div class="app-main">
    <!-- Map Container -->
    <div class="map-container">
      <div class="map-floating-panel">
        <div class="nearest-banner" id="nearestBanner" style="display: none;">
          <div class="nearest-text" id="nearestText">Calculare cel mai apropiat punct...</div>
          <button class="btn-header" id="btnNearestNav" style="background:#00b4d8; color:#000; border:none; padding:4px 8px; font-size:11px;">🧭 Waze</button>
        </div>
      </div>
      <div id="map"></div>
    </div>

    <!-- Store List Drawer -->
    <div class="store-drawer" id="storeDrawer">
      <div class="drawer-handle-bar" onclick="toggleDrawer()"></div>
      <div class="drawer-header">
        <div class="drawer-title" id="drawerTitle">Ziua 1</div>
        <div class="progress-pill" id="dayProgress">0 / 0 (0%)</div>
      </div>

      <!-- Quick Search & Status Filter -->
      <div class="drawer-search-row">
        <input type="text" class="search-input" id="searchBox" placeholder="🔍 Caută magazin sau stradă..." oninput="onSearchOrFilterChange()" />
        <div class="filter-btn-group">
          <button class="btn-filter active" id="fltAll" onclick="setFilter('all')">Toate</button>
          <button class="btn-filter" id="fltPending" onclick="setFilter('pending')">Rămase</button>
          <button class="btn-filter" id="fltDone" onclick="setFilter('completed')">Gata</button>
        </div>
      </div>

      <div class="store-list" id="storeList"></div>
    </div>
  </div>

  <!-- Draggable Floating FAB Button (Audit) -->
  <div class="draggable-fab" id="draggableFab" title="Trage oriunde sau apasă pentru Audit">
    <div class="fab-icon">📝</div>
    <div>AUDIT</div>
  </div>

  <!-- Audit Modal -->
  <div class="modal-overlay" id="auditModal">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title" id="auditModalTitle">Audit Magazin Teren</div>
        <button class="btn-close" onclick="closeModal('auditModal')">✕</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Magazin Selectat</label>
          <select class="form-select" id="auditStoreSelect" onchange="onAuditStoreSelectChange()"></select>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Categorie Produs</label>
