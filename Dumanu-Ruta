      list.innerHTML = "";

      let dayStores = storesData.filter(s => s.day === currentDay);

      // Status Filter
      if (currentFilter === 'pending') dayStores = dayStores.filter(s => s.status === 'pending');
      if (currentFilter === 'completed') dayStores = dayStores.filter(s => s.status === 'completed');

      // Search Filter
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        dayStores = dayStores.filter(s => 
          s.name.toLowerCase().includes(q) || 
          s.address.toLowerCase().includes(q) || 
          s.brand.toLowerCase().includes(q)
        );
      }

      if (dayStores.length === 0) {
        list.innerHTML = `<div style="text-align:center; color:#64748b; font-size:12px; padding:20px;">Niciun magazin găsit.</div>`;
        return;
      }

      dayStores.forEach((s) => {
        const card = document.createElement("div");
        card.id = `card-${s.id}`;
        card.className = `store-card ${s.status} ${s.id === selectedStoreId ? 'active' : ''}`;
        
        let tagClass = 'tag-mega';
        if (s.brand.toLowerCase().includes('penny')) tagClass = 'tag-penny';
        if (s.brand.toLowerCase().includes('profi')) tagClass = 'tag-profi';

        let statusBadge = `<span class="status-badge pending">NEÎNCEPUT</span>`;
        if (s.status === 'completed') statusBadge = `<span class="status-badge completed">REZOLVAT ${s.timestamp || ''}</span>`;
        if (s.status === 'failed') statusBadge = `<span class="status-badge failed">NEREZOLVAT</span>`;

        let distText = '';
        if (userLocation) {
          const d = haversine(userLocation.lat, userLocation.lng, s.lat, s.lng);
          distText = `<div class="store-live-dist">📍 ${d < 1 ? Math.round(d * 1000) + ' m' : d.toFixed(1) + ' km'} de tine</div>`;
        }

        card.innerHTML = `
          <div class="card-top" onclick="selectStore('${s.id}', true)">
            <div class="card-info">
              <div class="store-name">
                <span class="store-seq">#${s.seq}</span>
                <span class="store-brand-tag ${tagClass}">${s.brand}</span>
                <span>${s.name}</span>
              </div>
              <div class="store-address">📍 ${s.address}</div>
              ${distText}
              ${s.reason ? `<div style="font-size:11px; color:#f87171; margin-top:2px;">⚠️ Motiv: ${s.reason}</div>` : ''}
              ${s.audit && s.audit.oos ? `<div style="font-size:11px; color:#fbbf24; font-weight:700;">⚠️ LIPSĂ STOC (OOS)</div>` : ''}
            </div>
            ${statusBadge}
          </div>
          <div class="card-actions">
            <a class="btn-action btn-waze" href="https://waze.com/ul?ll=${s.lat},${s.lng}&navigate=yes" target="_blank">🧭 Waze</a>
            <a class="btn-action btn-gmaps" href="https://www.google.com/maps/dir/?api=1&destination=${s.lat},${s.lng}" target="_blank">🗺️ Maps</a>
            <button class="btn-action btn-resolve" onclick="markStatus('${s.id}', 'completed')">✅ Rezolvat</button>
            <button class="btn-action btn-unresolve" onclick="openUnresolvedModal('${s.id}')">❌ Nerezolvat</button>
            <button class="btn-action btn-audit" onclick="openAuditModalForStore('${s.id}')">📝 Audit</button>
          </div>
