    /* ==========================================================================
       GPS LIVE TRACKING WITH ON/OFF TOGGLE & MOVING PIN
       ========================================================================== */
    function toggleGpsTracking() {
      if (isTrackingGPS) {
        stopGpsTracking();
      } else {
        startGpsTracking();
      }
    }

    function startGpsTracking() {
      if (!navigator.geolocation) {
        alert("Geolocația nu este suportată de browser.");
        return;
      }

      const btn = document.getElementById("btnGpsToggle");
      btn.innerText = "⏳ Conectare...";

      gpsWatchId = navigator.geolocation.watchPosition(
        (pos) => {
          isTrackingGPS = true;
          userLocation = {
            lat: pos.coords.latitude,
            lng: pos.coords.longitude,
            accuracy: pos.coords.accuracy
          };

          btn.className = "btn-header btn-gps-toggle active";
          btn.innerHTML = "🟢 GPS Activ (Live)";

          // Update Live Marker
          if (!userMarker) {
            const gpsIcon = L.divIcon({
              className: 'custom-div-icon',
              html: `<div class="live-gps-marker" title="Locația ta Live"></div>`,
              iconSize: [20, 20],
              iconAnchor: [10, 10]
            });
            userMarker = L.marker([userLocation.lat, userLocation.lng], { icon: gpsIcon, zIndexOffset: 1000 }).addTo(map);
            userAccuracyCircle = L.circle([userLocation.lat, userLocation.lng], {
              radius: Math.max(userLocation.accuracy, 20),
              color: '#0284c7',
              weight: 1,
              fillColor: '#38bdf8',
              fillOpacity: 0.15
            }).addTo(map);
          } else {
            userMarker.setLatLng([userLocation.lat, userLocation.lng]);
            userAccuracyCircle.setLatLng([userLocation.lat, userLocation.lng]);
            userAccuracyCircle.setRadius(Math.max(userLocation.accuracy, 20));
          }

          renderStoreList();
          updateNearestBanner();
        },
        (err) => {
          console.warn("GPS Error:", err.message);
          stopGpsTracking();
          alert("Eroare GPS: " + err.message + ". Asigură-te că ai activat locația pe telefon.");
        },
        { enableHighAccuracy: true, timeout: 15000, maximumAge: 2000 }
      );
    }

    function stopGpsTracking() {
      if (gpsWatchId !== null) {
        navigator.geolocation.clearWatch(gpsWatchId);
        gpsWatchId = null;
      }
      isTrackingGPS = false;
      userLocation = null;

      if (userMarker) {
        map.removeLayer(userMarker);
        userMarker = null;
      }
      if (userAccuracyCircle) {
        map.removeLayer(userAccuracyCircle);
        userAccuracyCircle = null;
      }

      const btn = document.getElementById("btnGpsToggle");
      btn.className = "btn-header btn-gps-toggle";
      btn.innerHTML = "🛰️ Pornire GPS";

      document.getElementById("nearestBanner").style.display = "none";
      renderStoreList();
    }

    function haversine(lat1, lon1, lat2, lon2) {
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon/2) * Math.sin(dLon/2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

    function updateNearestBanner() {
      const banner = document.getElementById("nearestBanner");
      if (!userLocation) { banner.style.display = "none"; return; }

      const pending = storesData.filter(s => s.day === currentDay && s.status === 'pending');
      if (pending.length === 0) { banner.style.display = "none"; return; }

      let closest = null, minD = Infinity;
      pending.forEach(s => {
        const d = haversine(userLocation.lat, userLocation.lng, s.lat, s.lng);
        if (d < minD) { minD = d; closest = s; }
      });

      if (closest) {
        banner.style.display = "flex";
        const distFormat = minD < 1 ? Math.round(minD * 1000) + ' m' : minD.toFixed(1) + ' km';
        document.getElementById("nearestText").innerHTML = `Următorul cel mai apropiat: <strong>${closest.name}</strong> (${distFormat})`;
        document.getElementById("btnNearestNav").onclick = () => {
          selectStore(closest.id, true);
          window.open(`https://waze.com/ul?ll=${closest.lat},${closest.lng}&navigate=yes`, '_blank');
        };
      } else {
        banner.style.display = "none";
      }
    }

    /* Draggable FAB */
    function initDraggableFab() {
      const fab = document.getElementById("draggableFab");
      let isDrag = false, startX, startY, initLeft, initTop;

      const savedPos = localStorage.getItem("fab_pos_124_v4");
      if (savedPos) {
        try {
          const { x, y } = JSON.parse(savedPos);
          fab.style.left = `${x}px`;
          fab.style.top = `${y}px`;
        } catch(e) {}
      } else {
        fab.style.right = '20px';
        fab.style.bottom = '180px';
      }

      function start(e) {
        const t = e.touches ? e.touches[0] : e;
        startX = t.clientX;
        startY = t.clientY;
        const rect = fab.getBoundingClientRect();
        initLeft = rect.left;
        initTop = rect.top;
        isDrag = false;

        document.addEventListener(e.touches ? 'touchmove' : 'mousemove', move, { passive: false });
        document.addEventListener(e.touches ? 'touchend' : 'mouseup', end);
      }

      function move(e) {
        const t = e.touches ? e.touches[0] : e;
        const dx = t.clientX - startX;
        const dy = t.clientY - startY;

        if (Math.abs(dx) > 6 || Math.abs(dy) > 6) {
          isDrag = true;
          if (e.cancelable) e.preventDefault();
        }

        if (isDrag) {
          let nx = Math.max(10, Math.min(window.innerWidth - 66, initLeft + dx));
          let ny = Math.max(65, Math.min(window.innerHeight - 75, initTop + dy));
          fab.style.left = `${nx}px`;
          fab.style.top = `${ny}px`;
          fab.style.right = 'auto';
          fab.style.bottom = 'auto';
        }
      }

      function end() {
        document.removeEventListener('touchmove', move);
        document.removeEventListener('mousemove', move);
        document.removeEventListener('touchend', end);
        document.removeEventListener('mouseup', end);

        if (isDrag) {
          const r = fab.getBoundingClientRect();
          localStorage.setItem("fab_pos_124_v4", JSON.stringify({ x: r.left, y: r.top }));
        } else {
          openAuditModalForStore(selectedStoreId || storesData.find(s => s.day === currentDay)?.id);
        }
      }

      fab.addEventListener('touchstart', start, { passive: true });
      fab.addEventListener('mousedown', start);
    }

