        list.appendChild(card);
      });
    }

    function selectStore(storeId, pan = false) {
      selectedStoreId = storeId;
      document.querySelectorAll(".store-card").forEach(el => el.classList.remove("active"));
      const card = document.getElementById(`card-${storeId}`);
      if (card) {
        card.classList.add("active");
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      const store = storesData.find(s => s.id === storeId);
      if (pan && store && map) {
        map.flyTo([store.lat, store.lng], 16, { duration: 0.8 });
      }
    }

    function recenterRoute() {
      const dayStores = storesData.filter(s => s.day === currentDay);
      const bounds = L.latLngBounds([[HOME_COORDS.lat, HOME_COORDS.lng], ...dayStores.map(s => [s.lat, s.lng])]);
      map.fitBounds(bounds, { padding: [40, 40] });
    }

    function recenterHome() {
      map.flyTo([HOME_COORDS.lat, HOME_COORDS.lng], 14, { duration: 1 });
    }

    function setFilter(flt) {
      currentFilter = flt;
      document.getElementById('fltAll').className = `btn-filter ${flt === 'all' ? 'active' : ''}`;
      document.getElementById('fltPending').className = `btn-filter ${flt === 'pending' ? 'active' : ''}`;
      document.getElementById('fltDone').className = `btn-filter ${flt === 'completed' ? 'active' : ''}`;
