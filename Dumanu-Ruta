    function handlePhotoUpload(e, type) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement('canvas');
          let w = img.width, h = img.height, maxDim = 850;
          if (w > maxDim || h > maxDim) {
            if (w > h) { h = Math.round((h * maxDim) / w); w = maxDim; }
            else { w = Math.round((w * maxDim) / h); h = maxDim; }
          }
          canvas.width = w; canvas.height = h;
          canvas.getContext('2d').drawImage(img, 0, 0, w, h);
          const compressed = canvas.toDataURL('image/jpeg', 0.72);

          const s = storesData.find(item => item.id === selectedStoreId);
          if (s) {
            if (type === 'before') {
              s.audit.photoBefore = compressed;
              document.getElementById("previewPhotoBefore").src = compressed;
              document.getElementById("previewPhotoBefore").style.display = "block";
            } else {
              s.audit.photoAfter = compressed;
              document.getElementById("previewPhotoAfter").src = compressed;
              document.getElementById("previewPhotoAfter").style.display = "block";
            }
          }
        };
        img.src = evt.target.result;
      };
      reader.readAsDataURL(file);
    }

