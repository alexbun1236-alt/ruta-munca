    }

    function markStatus(storeId, newStatus, reason = "") {
      const store = storesData.find(s => s.id === storeId);
      if (!store) return;

      store.status = newStatus;
      store.reason = reason;
      if (newStatus === 'completed') {
        const d = new Date();
        store.timestamp = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
        if (navigator.vibrate) navigator.vibrate(50);
      } else if (newStatus === 'pending') {
        store.timestamp = null;
      }

      saveToStorage();
      renderDayChips();
      renderCurrentDay();
    }

    function openUnresolvedModal(storeId) {
      document.getElementById("unresolvedStoreId").value = storeId;
