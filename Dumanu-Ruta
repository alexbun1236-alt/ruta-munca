    /* ==========================================================================
       MAP & GOOGLE MAPS TILE LAYERS INITIALIZATION
       ========================================================================== */
    function initMap() {
      // 1. Define High Precision Google Maps Tile Layers
      const googleRoadmap = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
        maxZoom: 21,
        attribution: 'Google Maps'
      });

      const googleHybrid = L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 21,
        attribution: 'Google Maps Satelit'
      });

      const googleTerrain = L.tileLayer('https://mt1.google.com/vt/lyrs=p&x={x}&y={y}&z={z}', {
        maxZoom: 21,
        attribution: 'Google Teren'
      });

      const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: 'OpenStreetMap'
      });

      // Initialize map with Google Roadmap as Default
      map = L.map('map', { 
        zoomControl: false, 
        attributionControl: false,
        layers: [googleRoadmap] 
      }).setView([HOME_COORDS.lat, HOME_COORDS.lng], 12);

      // Layer Control (Switcher for Google Maps / Satellite / OSM)
      const baseMaps = {
        "🗺️ Google Străzi": googleRoadmap,
        "🛰️ Google Satelit": googleHybrid,
        "🏔️ Google Teren": googleTerrain,
        "🌍 OpenStreetMap": osmLayer
      };
      L.control.layers(baseMaps, null, { position: 'topright' }).addTo(map);
      L.control.zoom({ position: 'topright' }).addTo(map);

      markersLayer = L.layerGroup().addTo(map);
      routeLayer = L.layerGroup().addTo(map);

      renderDayChips();
      renderCurrentDay();
      initDraggableFab();
    }

    function renderDayChips() {
      const container = document.getElementById("dayChipsBar");
      container.innerHTML = "";

      for (let d = 1; d <= 10; d++) {
        const dayStores = storesData.filter(s => s.day === d);
        const compCount = dayStores.filter(s => s.status === 'completed').length;
        
        const chip = document.createElement("button");
        chip.className = `day-chip ${d === currentDay ? 'active' : ''}`;
        chip.innerHTML = `<span>${d <= 5 ? 'S1' : 'S2'}·Z${d}</span> <span class="chip-count">${compCount}/${dayStores.length}</span>`;
        chip.onclick = () => switchDay(d);
        container.appendChild(chip);
      }
    }

    function switchDay(d) {
      currentDay = d;
      searchQuery = '';
      document.getElementById("searchBox").value = '';
      renderDayChips();
      renderCurrentDay();
    }

    function renderCurrentDay() {
      markersLayer.clearLayers();
      routeLayer.clearLayers();

      const dayStores = storesData.filter(s => s.day === currentDay);
      document.getElementById("drawerTitle").innerText = DAY_DESCRIPTIONS[currentDay] || `Ziua ${currentDay}`;

      const completed = dayStores.filter(s => s.status === 'completed').length;
      const failed = dayStores.filter(s => s.status === 'failed').length;
      const total = dayStores.length;
      const pct = total ? Math.round((completed / total) * 100) : 0;
      document.getElementById("dayProgress").innerText = `${completed + failed}/${total} (${pct}%)`;

      // Draw Home Pin (Brănești)
      const homeIcon = L.divIcon({
        className: 'custom-div-icon',
        html: `<div class="custom-pin home" title="Baza Acasă Brănești">🏠</div>`,
        iconSize: [30, 30],
        iconAnchor: [15, 15]
      });
      L.marker([HOME_COORDS.lat, HOME_COORDS.lng], { icon: homeIcon })
        .addTo(markersLayer)
        .bindPopup(`<b>🏠 Baza Acasă (Brănești, Ilfov)</b><br>Pornire și sosire zilnică optimizată.`);

      // Polyline starting from Brănești -> All day stores -> Back to Brănești
      const routePoints = [[HOME_COORDS.lat, HOME_COORDS.lng]];

      dayStores.forEach((s) => {
        const isActive = s.id === selectedStoreId;
        const pinClass = `custom-pin ${s.status} ${isActive ? 'active' : ''}`;

        const icon = L.divIcon({
          className: 'custom-div-icon',
          html: `<div class="${pinClass}">${s.seq}</div>`,
          iconSize: [30, 30],
          iconAnchor: [15, 15]
        });

        L.marker([s.lat, s.lng], { icon: icon })
          .addTo(markersLayer)
          .on('click', () => selectStore(s.id, true));

        routePoints.push([s.lat, s.lng]);
      });

      routePoints.push([HOME_COORDS.lat, HOME_COORDS.lng]);

      L.polyline(routePoints, {
        color: '#3b82f6',
        weight: 3.5,
        opacity: 0.75,
        dashArray: '6, 8'
      }).addTo(routeLayer);

      renderStoreList();
      recenterRoute();
      updateNearestBanner();
    }

    function renderStoreList() {
